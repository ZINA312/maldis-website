---
const navItems = [
  { href: '#services', label: 'Услуги' },
  { href: '#warehouses', label: 'Склады' },
  { href: '#about', label: 'О компании' },
  { href: '#contacts', label: 'Контакты' },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-brand-900/95 backdrop-blur-md">
  <div class="container-main flex h-16 items-center justify-between px-4 sm:px-6 lg:px-8">
    <a href="#" class="flex items-center gap-2">
      <span class="text-lg font-bold text-white">Малдис</span>
    </a>

    <nav class="hidden items-center gap-8 md:flex">
      {navItems.map((item) => (
        <a href={item.href} class="text-sm font-medium text-white/80 transition hover:text-white">
          {item.label}
        </a>
      ))}
    </nav>

    <a href="#contacts" class="btn-primary hidden text-sm md:inline-flex">Связаться</a>

    <button
      id="mobile-menu-btn"
      class="inline-flex items-center justify-center rounded-lg p-2 text-white md:hidden"
      aria-label="Меню"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-white/10 bg-brand-900 px-4 py-4 md:hidden">
    {navItems.map((item) => (
      <a href={item.href} class="block py-2 text-sm font-medium text-white/80 hover:text-white">
        {item.label}
      </a>
    ))}
    <a href="#contacts" class="btn-primary mt-3 w-full">Связаться</a>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => menu.classList.add('hidden'));
  });
</script>
