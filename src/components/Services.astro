---

<section id="services" class="section-padding bg-gray-50">
  <div class="container-main">
    <div class="mb-12 text-center">
      <h2 class="mb-4 text-3xl font-bold text-brand-900 sm:text-4xl">Наши услуги</h2>
      <p class="mx-auto max-w-2xl text-gray-600">
        Полный комплекс услуг для хранения, логистики и обработки продукции
      </p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => (
        <div class="card group">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-50 text-brand-600 transition group-hover:bg-brand-500 group-hover:text-white">
            {svgIcons[service.icon] ? (
              <svg
                class="h-6 w-6"
                viewBox={svgIcons[service.icon].viewBox}
                fill={svgIcons[service.icon].filled ? 'currentColor' : 'none'}
                aria-hidden="true"
                set:html={svgIcons[service.icon].filled
                  ? `<path d="${svgIcons[service.icon].paths}" />`
                  : svgIcons[service.icon].paths}
              />
            ) : (
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d={pathIcons[service.icon]} />
              </svg>
            )}
          </div>
          <h3 class="mb-2 text-lg font-semibold text-brand-900">{service.title}</h3>
          <p class="text-sm leading-relaxed text-gray-600">{service.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
