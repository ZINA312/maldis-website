---
import { clients } from '../data/clients';
import { withBase } from '../utils/baseUrl';
---

{
  clients.length > 0 && (
    <section id="clients" class="scroll-mt-24 overflow-hidden bg-white py-16 lg:py-24">
      <div class="container-main mb-10 px-4 text-center sm:px-6 lg:px-8">
        <h2 class="mb-4 text-3xl font-bold text-brand-900 sm:text-4xl">Нам доверяют</h2>
        <p class="mx-auto max-w-2xl text-gray-600">
          Компании, которые доверяют нам хранение и логистику
        </p>
      </div>

      <div class="clients-marquee relative w-full" data-clients-marquee>
        <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-24 bg-gradient-to-r from-white from-20% to-transparent sm:w-40 lg:w-56"></div>
        <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-24 bg-gradient-to-l from-white from-20% to-transparent sm:w-40 lg:w-56"></div>

        <div class="clients-track">
          <div class="clients-set">
            {clients.map((client) => (
              <div class="clients-item">
                {client.url ? (
                  <a
                    href={client.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex h-full w-full items-center justify-center transition hover:opacity-80"
                  >
                    <img
                      src={withBase(client.logo)}
                      alt={client.name}
                      class="max-h-24 max-w-full object-contain opacity-80 grayscale transition hover:opacity-100 hover:grayscale-0 sm:max-h-28"
                      loading="lazy"
                    />
                  </a>
                ) : (
                  <img
                    src={withBase(client.logo)}
                    alt={client.name}
                    class="max-h-24 max-w-full object-contain opacity-80 grayscale transition hover:opacity-100 hover:grayscale-0 sm:max-h-28"
                    loading="lazy"
                  />
                )}
              </div>
            ))}
          </div>
          <div class="clients-set clients-set-clone" aria-hidden="true">
            {clients.map((client) => (
              <div class="clients-item">
                {client.url ? (
                  <a
                    href={client.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex h-full w-full items-center justify-center"
                    tabindex={-1}
                  >
                    <img
                      src={withBase(client.logo)}
                      alt=""
                      class="max-h-24 max-w-full object-contain opacity-80 grayscale sm:max-h-28"
                      loading="lazy"
                    />
                  </a>
                ) : (
                  <img
                    src={withBase(client.logo)}
                    alt=""
                    class="max-h-24 max-w-full object-contain opacity-80 grayscale sm:max-h-28"
                    loading="lazy"
                  />
                )}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  .clients-track {
    display: flex;
    width: -webkit-max-content;
    width: max-content;
    align-items: center;
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
    -webkit-animation: clients-scroll 35s linear infinite;
    animation: clients-scroll 35s linear infinite;
  }

  .clients-set {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .clients-item {
    display: flex;
    height: 7rem;
    width: 13rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    margin-right: 3rem;
  }

  @media (min-width: 640px) {
    .clients-item {
      height: 8rem;
      width: 16rem;
      margin-right: 5rem;
    }
  }

  .clients-marquee:hover .clients-track {
    -webkit-animation-play-state: paused;
    animation-play-state: paused;
  }

  @-webkit-keyframes clients-scroll {
    from {
      -webkit-transform: translateX(0);
      transform: translateX(0);
    }
    to {
      -webkit-transform: translateX(-50%);
      transform: translateX(-50%);
    }
  }

  @keyframes clients-scroll {
    from {
      -webkit-transform: translateX(0);
      transform: translateX(0);
    }
    to {
      -webkit-transform: translateX(-50%);
      transform: translateX(-50%);
    }
  }

  /* Без анимации — одна сетка, без дубля (часто на iOS с «Уменьшить движение») */
  @media (prefers-reduced-motion: reduce) {
    .clients-marquee {
      overflow: visible;
    }

    .clients-track {
      -webkit-animation: none;
      animation: none;
      display: block;
      width: 100%;
      max-width: 80rem;
      margin-left: auto;
      margin-right: auto;
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .clients-set {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
    }

    .clients-set-clone {
      display: none;
    }

    .clients-item {
      margin-right: 1.5rem;
      margin-left: 1.5rem;
      margin-bottom: 1rem;
    }
  }

  .clients-marquee.clients-static .clients-track {
    -webkit-animation: none;
    animation: none;
    display: block;
    width: 100%;
    max-width: 80rem;
    margin-left: auto;
    margin-right: auto;
    padding-left: 1rem;
    padding-right: 1rem;
  }

  .clients-marquee.clients-static .clients-set {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
  }

  .clients-marquee.clients-static .clients-set-clone {
    display: none;
  }

  .clients-marquee.clients-static .clients-item {
    margin-right: 1.5rem;
    margin-left: 1.5rem;
    margin-bottom: 1rem;
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const marquee = document.querySelector('[data-clients-marquee]');
  if (marquee) {
    const track = marquee.querySelector('.clients-track');
    const clone = marquee.querySelector('.clients-set-clone');
    const applyFallback = () => {
      if (!track || !clone) return;
      const anim = window.getComputedStyle(track).animationName;
      const noAnim = reduceMotion.matches || !anim || anim === 'none';
      marquee.classList.toggle('clients-static', noAnim);
    };
    applyFallback();
    if (typeof reduceMotion.addEventListener === 'function') {
      reduceMotion.addEventListener('change', applyFallback);
    } else if (typeof reduceMotion.addListener === 'function') {
      reduceMotion.addListener(applyFallback);
    }
  }
</script>
