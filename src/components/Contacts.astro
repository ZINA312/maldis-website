---
import { contacts } from '../data/contacts';
---

<section id="contacts" class="section-padding bg-gray-50">
  <div class="container-main">
    <div class="mb-12 text-center">
      <h2 class="mb-4 text-3xl font-bold text-brand-900 sm:text-4xl">Контакты и как добраться</h2>
      <p class="mx-auto max-w-2xl text-gray-600">
        Работаем ежедневно с 8:00 до 17:00.<br/>Клиенты могут получить круглосуточный доступ к продукции.
      </p>
    </div>

    <div class="mb-8 card">
      <h3 class="mb-4 text-lg font-semibold text-brand-900">Контактная информация</h3>
      <dl class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <div>
          <dt class="text-xs font-medium uppercase tracking-wider text-gray-500">Телефон</dt>
          <dd class="mt-1">
            <a href={`tel:${contacts.phone.replace(/[^\d+]/g, '')}`} class="text-brand-600 hover:underline">{contacts.phone}</a>
            {contacts.phoneSecondary && (
              <>, <a href={`tel:${contacts.phoneSecondary.replace(/[^\d+]/g, '')}`} class="text-brand-600 hover:underline">{contacts.phoneSecondary}</a></>
            )}
          </dd>
        </div>
        <div>
          <dt class="text-xs font-medium uppercase tracking-wider text-gray-500">Email</dt>
          <dd class="mt-1"><a href={`mailto:${contacts.email}`} class="text-brand-600 hover:underline">{contacts.email}</a></dd>
        </div>
        <div>
          <dt class="text-xs font-medium uppercase tracking-wider text-gray-500">Адрес</dt>
          <dd class="mt-1 text-gray-700">{contacts.address}</dd>
        </div>
        <div>
          <dt class="text-xs font-medium uppercase tracking-wider text-gray-500">Режим работы офиса</dt>
          <dd class="mt-1 text-gray-700">{contacts.workingHours}</dd>
        </div>
        <div class="sm:col-span-2 lg:col-span-2">
          <dt class="text-xs font-medium uppercase tracking-wider text-gray-500">Доступ клиентов</dt>
          <dd class="mt-1 text-gray-700">{contacts.clientAccess}</dd>
        </div>
      </dl>

      <div class="mt-6 flex items-start gap-3 rounded-xl bg-brand-50 p-4">
        <svg class="mt-0.5 h-5 w-5 shrink-0 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
        </svg>
        <p class="text-sm text-brand-800">{contacts.videoSurveillance}</p>
      </div>
    </div>

    <div class="grid gap-8 lg:grid-cols-2">
      <div class="card !p-0 overflow-hidden">
        <div class="border-b border-gray-100 p-5">
          <h3 class="mb-3 flex items-center gap-2 text-lg font-semibold text-brand-900">
            <svg class="h-5 w-5 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8L5.72187 10.2682C5.90158 10.418 6.12811 10.5 6.36205 10.5H17.6379C17.8719 10.5 18.0984 10.418 18.2781 10.2682L21 8M6.5 14H6.51M17.5 14H17.51M8.16065 4.5H15.8394C16.5571 4.5 17.2198 4.88457 17.5758 5.50772L20.473 10.5777C20.8183 11.1821 21 11.8661 21 12.5623V18.5C21 19.0523 20.5523 19.5 20 19.5H19C18.4477 19.5 18 19.0523 18 18.5V17.5H6V18.5C6 19.0523 5.55228 19.5 5 19.5H4C3.44772 19.5 3 19.0523 3 18.5V12.5623C3 11.8661 3.18166 11.1821 3.52703 10.5777L6.42416 5.50772C6.78024 4.88457 7.44293 4.5 8.16065 4.5ZM7 14C7 14.2761 6.77614 14.5 6.5 14.5C6.22386 14.5 6 14.2761 6 14C6 13.7239 6.22386 13.5 6.5 13.5C6.77614 13.5 7 13.7239 7 14ZM18 14C18 14.2761 17.7761 14.5 17.5 14.5C17.2239 14.5 17 14.2761 17 14C17 13.7239 17.2239 13.5 17.5 13.5C17.7761 13.5 18 13.7239 18 14Z" />
            </svg>
            {contacts.directions.car.title}
          </h3>
          <ol class="list-inside list-decimal space-y-2 text-sm text-gray-600">
            {contacts.directions.car.steps.map((step) => (
              <li>{step}</li>
            ))}
          </ol>
        </div>
        <iframe
          src={contacts.directions.car.mapEmbedUrl}
          width="100%"
          height="360"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          title="Карта — заезд на легковом автомобиле"
        ></iframe>
      </div>

      <div class="card !p-0 overflow-hidden">
        <div class="border-b border-gray-100 p-5">
          <h3 class="mb-3 flex items-center gap-2 text-lg font-semibold text-brand-900">
            <svg class="h-5 w-5 shrink-0 -translate-y-0.5 text-brand-500" viewBox="0 0 50 50" fill="currentColor" aria-hidden="true" stroke="currentColor" stroke-width="1.5">
              <path d="M2.84375 13C1.285156 13 0 14.285156 0 15.84375L0 42C0 43.660156 1.339844 45 3 45L7.09375 45C7.570313 47.835938 10.035156 50 13 50C15.964844 50 18.429688 47.835938 18.90625 45L28.15625 45C28.894531 45 29.554688 44.6875 30.0625 44.21875C30.582031 44.675781 31.246094 44.992188 32 45L33.09375 45C33.570313 47.835938 36.035156 50 39 50C42.300781 50 45 47.300781 45 44C45 40.699219 42.300781 38 39 38C36.035156 38 33.570313 40.164063 33.09375 43L32 43C31.8125 43 31.527344 42.871094 31.3125 42.65625C31.097656 42.441406 31 42.183594 31 42L31 23C31 22.625 31.625 22 32 22L40 22C40.785156 22 41.890625 22.839844 42.65625 23.75C42.664063 23.761719 42.679688 23.769531 42.6875 23.78125L42.84375 24L38 24C36.40625 24 35 25.289063 35 27L35 31C35 31.832031 35.375 32.5625 35.90625 33.09375C36.4375 33.625 37.167969 34 38 34L48 34L48 42C48 42.375 47.375 43 47 43L45 43L45 45L47 45C48.660156 45 50 43.660156 50 42L50 32.375C50 30.085938 48.40625 28.0625 48.40625 28.0625L48.375 28.0625L44.25 22.5625L44.25 22.53125L44.21875 22.5C43.296875 21.386719 41.914063 20 40 20L32 20C31.644531 20 31.316406 20.074219 31 20.1875L31 15.90625C31 14.371094 29.789063 13 28.1875 13 Z M 2.84375 15L28.1875 15C28.617188 15 29 15.414063 29 15.90625L29 42.15625C29 42.625 28.628906 43 28.15625 43L18.90625 43C18.429688 40.164063 15.964844 38 13 38C10.035156 38 7.570313 40.164063 7.09375 43L3 43C2.625 43 2 42.371094 2 42L2 15.84375C2 15.375 2.367188 15 2.84375 15 Z M 38 26L44.34375 26L46.78125 29.25C46.78125 29.25 47.6875 30.800781 47.875 32L38 32C37.832031 32 37.5625 31.875 37.34375 31.65625C37.125 31.4375 37 31.167969 37 31L37 27C37 26.496094 37.59375 26 38 26 Z M 13 40C15.222656 40 17 41.777344 17 44C17 46.222656 15.222656 48 13 48C10.777344 48 9 46.222656 9 44C9 41.777344 10.777344 40 13 40 Z M 39 40C41.222656 40 43 41.777344 43 44C43 46.222656 41.222656 48 39 48C36.777344 48 35 46.222656 35 44C35 41.777344 36.777344 40 39 40Z" />
            </svg>
            {contacts.directions.truck.title}
          </h3>
          <ol class="list-inside list-decimal space-y-2 text-sm text-gray-600">
            {contacts.directions.truck.steps.map((step) => (
              <li>{step}</li>
            ))}
          </ol>
        </div>
        <iframe
          src={contacts.directions.truck.mapEmbedUrl}
          width="100%"
          height="360"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          title="Карта — заезд на грузовом автомобиле"
        ></iframe>
      </div>
    </div>
  </div>
</section>
