---
import { company } from '../data/company';
---

<section id="about" class="section-padding bg-brand-900 text-white">
  <div class="container-main">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
      <div>
        <h2 class="mb-4 text-3xl font-bold sm:text-4xl">О компании «{company.name}»</h2>
        <p class="mb-6 text-lg text-white/80">{company.description}</p>
        <ul class="space-y-3">
          {company.about.map((item) => (
            <li class="flex items-start gap-3">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-frost-300" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span class="text-white/90">{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="grid grid-cols-2 gap-4">
        {company.stats.map((stat) => (
          <div class="rounded-2xl bg-white/10 p-6 text-center backdrop-blur">
            <div class="text-3xl font-bold text-frost-200">{stat.value}</div>
            <div class="mt-2 text-sm text-white/70">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
