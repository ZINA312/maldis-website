---
import { company } from '../data/company';
---

<section class="relative flex min-h-screen items-center overflow-hidden bg-gradient-to-br from-brand-900 via-brand-800 to-brand-700 pt-16">
  <div class="absolute inset-0 opacity-10">
    <svg class="h-full w-full" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M 40 0 L 0 0 0 40" fill="none" stroke="white" stroke-width="0.5"></path>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#grid)"></rect>
    </svg>
  </div>

  <div class="container-main relative z-10 section-padding">
    <div class="max-w-3xl">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-sm text-frost-200 backdrop-blur">
        <span class="h-2 w-2 rounded-full bg-frost-300"></span>
        Холодильное хранение и логистика
      </div>

      <h1 class="mb-6 text-4xl font-extrabold leading-tight tracking-tight text-white sm:text-5xl lg:text-6xl">
        {company.tagline}
      </h1>

      <p class="mb-8 max-w-2xl text-lg text-white/80 sm:text-xl">
        {company.description}
      </p>

      <div class="flex flex-wrap gap-4">
        <a href="#warehouses" class="btn-primary">Смотреть склады</a>
        <a href="#contacts" class="btn-outline border-white/30 text-white hover:bg-white/10">Связаться с нами</a>
      </div>
    </div>

    <div class="mt-16 grid grid-cols-2 gap-4 sm:grid-cols-4">
      {company.stats.map((stat) => (
        <div class="rounded-xl bg-white/10 p-4 text-center backdrop-blur sm:p-6">
          <div class="text-2xl font-bold text-white sm:text-3xl">{stat.value}</div>
          <div class="mt-1 text-xs text-white/70 sm:text-sm">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
